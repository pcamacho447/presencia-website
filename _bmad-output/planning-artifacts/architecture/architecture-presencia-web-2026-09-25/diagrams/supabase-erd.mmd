erDiagram
    LEADS {
        uuid id PK
        string nombre
        string whatsapp
        string ciudad
        string paquete
        date fecha_deseada
        timestamp created_at
    }

    SUBSCRIPTIONS {
        uuid id PK
        string email UK
        boolean active
        timestamp created_at
    }

    SITE_CONFIG {
        string key PK "hero | paquetes | catalogo"
        jsonb value "Configuracion JSON (precios, flores, textos, urls)"
        timestamp updated_at
    }

    LEADS ||--o{ SUBSCRIPTIONS : "puede suscribirse"
