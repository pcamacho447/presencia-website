---
import { getLangFromUrl, t } from '../i18n/utils';
import { defaultCatalog } from '../data/defaultCatalog';
import type { CatalogItem } from '../types/catalog';
import { createSupabaseServerClient } from '../lib/supabase';
import { getEnv } from '../lib/env';

const lang = getLangFromUrl(Astro.url);

// Try to fetch from Supabase
let catalogItems: CatalogItem[] = defaultCatalog;
try {
  const sb = createSupabaseServerClient(Astro);
  const { data, error } = await sb
    .from('site_config')
    .select('value')
    .eq('key', 'catalogo')
    .single();

  if (!error && data && data.value && Array.isArray(data.value)) {
    catalogItems = data.value as CatalogItem[];
  }
} catch (err) {
  console.error("Error fetching catalog from Supabase, using default:", err);
}

// Filter out unavailable items for the public view
const visibleItems = catalogItems.filter(item => item.disponible !== false);

// Base WhatsApp URL from environment or fallback
const whatsappNumber = getEnv(Astro, 'PUBLIC_WHATSAPP_NUMBER') || '51900000000';
---

<section id="catalog" class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-italiana text-stone-900 mb-4">{t(lang, 'catalog.title')}</h2>
      <p class="text-lg text-stone-600 font-raleway">{t(lang, 'catalog.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {visibleItems.map(item => {
        const title = lang === 'en' ? item.nombre_en : item.nombre_es;
        const flowers = lang === 'en' ? item.flores_en : item.flores_es;
        const waMessage = lang === 'en' 
          ? `Hello Presencia, I want to coordinate/confirm the floral arrangement: "${title}". City (Trujillo / Lima / Arequipa):` 
          : `Hola Presencia, deseo coordinar/confirmar el arreglo floral: "${title}". Mi ciudad es (Trujillo / Lima / Arequipa):`;
        const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waMessage)}`;

        return (
          <div class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden flex flex-col transition-transform hover:-translate-y-1 hover:shadow-md">
            <div class="aspect-w-4 aspect-h-3 w-full bg-stone-200">
              <img 
                src={item.imagen_url || '/images/hero-bg.jpg'} 
                alt={title} 
                class="w-full h-64 object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-italiana text-stone-900">{title}</h3>
                {item.destacado && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                    Top
                  </span>
                )}
              </div>
              <p class="text-sm text-stone-500 mb-4 font-raleway flex-grow">{flowers}</p>
              <div class="mt-auto">
                <div class="flex items-center gap-4 mb-4">
                  <span class="text-lg font-semibold text-stone-900">
                    {t(lang, 'catalog.currency_sol')} {item.precio_sol}
                  </span>
                  <span class="text-sm text-stone-500">
                    {t(lang, 'catalog.currency_usd')} {item.precio_usd}
                  </span>
                </div>
                {item.shopify_enabled && item.shopify_checkout_url ? (
                  <div class="space-y-2.5">
                    <a 
                      href={item.shopify_checkout_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex justify-center items-center px-4 py-3 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-primary hover:opacity-90 focus:outline-none transition-all"
                    >
                      <span class="mr-2 text-base">🛒</span> {lang === 'en' ? 'BUY ON SHOPIFY' : 'COMPRAR EN SHOPIFY'}
                    </a>
                    <a 
                      href={waLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex justify-center items-center px-4 py-3 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-whatsapp hover:brightness-105 focus:outline-none transition-all no-underline"
                    >
                      <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      {lang === 'en' ? 'COORDINATE ON WHATSAPP' : 'COORDINAR POR WHATSAPP'}
                    </a>
                    <p class="text-[11px] text-center text-stone-500 font-raleway pt-1 leading-tight">
                      📍 <strong>Trujillo · Lima · Arequipa</strong><br/>
                      {lang === 'en' 
                        ? 'Confirm payment with receipt & coordinate delivery' 
                        : 'Confirma tu pago con el comprobante y coordina la entrega'}
                    </p>
                  </div>
                ) : (
                  <div class="space-y-2">
                    <a 
                      href={waLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex justify-center items-center px-4 py-3 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-whatsapp hover:brightness-105 focus:outline-none transition-all no-underline"
                    >
                      <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      {t(lang, 'catalog.consult_whatsapp')}
                    </a>
                    <p class="text-[11px] text-center text-stone-500 font-raleway pt-1 leading-tight">
                      📍 <strong>Trujillo · Lima · Arequipa</strong>
                    </p>
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
