                <th class="p-3">Fecha</th>
                <th class="p-3">Consumidor</th>
                <th class="p-3">Documento</th>
                <th class="p-3">Tipo</th>
                <th class="p-3">Vence</th>
                <th class="p-3 rounded-r-lg text-right">Acción</th>
