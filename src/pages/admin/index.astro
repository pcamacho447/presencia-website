---
// src/pages/admin/index.astro
export const prerender = false;
Astro.response.headers.set('X-Astro-Reroute', 'no');

import { createClient } from '@supabase/supabase-js';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getEnv } from '../../lib/env';

interface Lead {
  nombre: string;
  whatsapp: string;
  ciudad: string;
  paquete: string;
  fecha_deseada: string | null;
  created_at: string;
}

let leads: Lead[] = [];
let loadError = false;
let errorMessage = '';

try {
  const url = getEnv(Astro, 'SUPABASE_URL');
  const serviceKey = getEnv(Astro, 'SUPABASE_SERVICE_ROLE_KEY');

  if (url && serviceKey) {
    const supabase = createClient(url, serviceKey, { auth: { persistSession: false } });
    const { data, error } = await supabase
      .from('leads')
      .select('nombre, whatsapp, ciudad, paquete, fecha_deseada, created_at')
      .order('created_at', { ascending: false });

    if (!error && data) {
      leads = data;
    } else if (error) {
      console.error('Supabase query error (service_role):', error.message);
      // Fallback a cliente autenticado
      const authSb = createSupabaseServerClient(Astro);
      const { data: authData, error: authError } = await authSb
        .from('leads')
        .select('nombre, whatsapp, ciudad, paquete, fecha_deseada, created_at')
        .order('created_at', { ascending: false });
      if (!authError && authData) {
        leads = authData;
      } else {
        loadError = true;
        errorMessage = error.message;
      }
    }
  } else {
    // Si no está serviceKey disponible, usar sesión autenticada directamente
    const authSb = createSupabaseServerClient(Astro);
    const { data: authData, error: authError } = await authSb
      .from('leads')
      .select('nombre, whatsapp, ciudad, paquete, fecha_deseada, created_at')
      .order('created_at', { ascending: false });

    if (!authError && authData) {
      leads = authData;
    } else {
      loadError = true;
      errorMessage = authError?.message || 'Falta configuración de Supabase';
    }
  }
} catch (err: any) {
  console.error('Exception loading leads:', err);
  loadError = true;
  errorMessage = err?.message || 'Error inesperado al conectar con Supabase';
}
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel de Administración · Flores en Paz</title>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Raleway:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: '#2b4c3b', secondary: '#f5f3e9', whatsapp: '#25d366' },
          fontFamily: { heading: ['Italiana', 'serif'], body: ['Raleway', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-secondary text-primary font-body min-h-screen p-4 md:p-8">
  <!-- Header principal -->
  <header class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center pb-6 border-b border-primary/20 gap-4 mb-6">
    <div>
      <h1 class="font-heading text-3xl font-bold tracking-wide">FLORES EN PAZ</h1>
      <p class="text-sm opacity-80">Panel de Control de Gestión Único</p>
    </div>
    <div class="flex items-center gap-4">
      <a href="/es/" target="_blank" class="text-sm underline hover:opacity-80">Ver sitio web ↗</a>
      <form method="POST" action="/api/admin/logout">
        <button type="submit" class="text-sm bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-100 transition font-semibold">
          Cerrar sesión
        </button>
      </form>
    </div>
  </header>

  <!-- Navegación por pestañas -->
  <div class="max-w-5xl mx-auto mb-6 flex flex-wrap gap-2 border-b border-primary/10 pb-4">
    <button
      id="tab-btn-leads"
      onclick="switchTab('leads')"
      class="tab-btn active bg-primary text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition hover:opacity-90 shadow-sm"
    >
      📋 Solicitudes de Clientes ({leads.length})
    </button>
    <button
      id="tab-reclamaciones"
      onclick="switchTab('reclamaciones')"
      class="tab-btn bg-white text-primary border border-primary/20 px-5 py-2.5 rounded-xl text-sm font-semibold transition hover:bg-primary/5"
    >
      📖 Libro de Reclamaciones
    </button>
    <button
      id="tab-btn-paquetes"
      onclick="switchTab('paquetes')"
      class="tab-btn bg-white text-primary border border-primary/20 px-5 py-2.5 rounded-xl text-sm font-semibold transition hover:bg-primary/5"
    >
      💐 Paquetes y Precios
    </button>
    <button
      id="tab-btn-catalogo"
      onclick="switchTab('catalogo')"
      class="tab-btn bg-white text-primary border border-primary/20 px-5 py-2.5 rounded-xl text-sm font-semibold transition hover:bg-primary/5"
    >
      🌻 Catálogo Floral
    </button>
    <button
      id="tab-btn-sitio"
      onclick="switchTab('sitio')"
      class="tab-btn bg-white text-primary border border-primary/20 px-5 py-2.5 rounded-xl text-sm font-semibold transition hover:bg-primary/5"
    >
      🎬 Hero y Contenidos
    </button>
  </div>

  <!-- Contenedor Principal -->
  <main class="max-w-5xl mx-auto">
    <!-- Pestaña 1: Solicitudes (Leads) -->
    <section id="tab-content-leads" class="tab-content block">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-primary/10">
        <div class="flex justify-between items-center mb-6">
          <h2 class="font-heading text-2xl font-bold">Solicitudes Recibidas</h2>
          <button onclick="location.reload()" class="text-xs bg-secondary text-primary px-3 py-1.5 rounded-lg border border-primary/10 hover:bg-primary/10">
            🔄 Actualizar
          </button>
        </div>

        {loadError && (
          <div class="text-center py-8">
            <p class="text-red-600 font-semibold mb-2">Error al cargar las solicitudes desde la base de datos.</p>
            {errorMessage && <p class="text-xs text-red-500 font-mono bg-red-50 p-2 rounded max-w-lg mx-auto">{errorMessage}</p>}
          </div>
        )}

        {!loadError && leads.length === 0 && (
          <div class="text-center py-12 text-primary/60 italic">
            Aún no hay solicitudes registradas de clientes.
          </div>
        )}

        {!loadError && leads.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead>
                <tr class="bg-primary text-white text-xs uppercase tracking-wider">
                  <th class="p-3 rounded-l-lg">Fecha</th>
                  <th class="p-3">Nombre</th>
                  <th class="p-3">WhatsApp</th>
                  <th class="p-3">Ciudad</th>
                  <th class="p-3">Paquete</th>
                  <th class="p-3 rounded-r-lg">Fecha Deseada</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-primary/10">
                {leads.map((lead) => (
                  <tr class="hover:bg-secondary/40 transition">
                    <td class="p-3 opacity-70 text-xs">{lead.created_at ? new Date(lead.created_at).toLocaleDateString('es-PE') : '—'}</td>
                    <td class="p-3 font-semibold">{lead.nombre}</td>
                    <td class="p-3">
                      <a
                        href={`https://wa.me/${(lead.whatsapp || '').replace(/\D/g, '')}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 bg-whatsapp/10 text-emerald-700 px-2.5 py-1 rounded-lg font-bold hover:bg-whatsapp/20 transition"
                      >
                        💬 {lead.whatsapp}
                      </a>
                    </td>
                    <td class="p-3">{lead.ciudad || '—'}</td>
                    <td class="p-3">
                      <span class="bg-primary/10 text-primary px-2.5 py-0.5 rounded-full text-xs font-semibold">
                        {lead.paquete || 'General'}
                      </span>
                    </td>
                    <td class="p-3 opacity-80">{lead.fecha_deseada || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
 
    <!-- Pestaña: Libro de Reclamaciones -->
    <section id="section-reclamaciones" class="tab-content hidden">
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-primary/10">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
          <div>
            <h2 class="font-heading text-2xl font-bold">Libro de Reclamaciones (INDECOPI)</h2>
            <p class="text-xs opacity-70">Hojas de reclamación registradas conforme a la Ley N° 29571 y Ley N° 31435 (plazo legal de respuesta: 15 días hábiles).</p>
          </div>
          <button type="button" onclick="loadReclamaciones(true)" class="text-xs bg-secondary text-primary px-3.5 py-2 rounded-lg border border-primary/10 hover:bg-primary/10 font-semibold transition flex items-center gap-1.5">
            🔄 Actualizar
          </button>
        </div>

        <div id="loading-reclamaciones" class="text-center py-8 opacity-70">
          Cargando reclamaciones desde Supabase...
        </div>

        <div id="error-reclamaciones" class="hidden text-center py-8">
          <p class="text-red-600 font-semibold mb-2">Error al cargar las reclamaciones desde la base de datos.</p>
          <p id="error-reclamaciones-msg" class="text-xs text-red-500 font-mono bg-red-50 p-2 rounded max-w-lg mx-auto"></p>
        </div>

        <div id="empty-reclamaciones" class="hidden text-center py-12 text-primary/60 italic">
