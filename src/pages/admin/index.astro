    // Lógica Libro de Reclamaciones
    let currentReclamaciones = [];
    async function loadReclamaciones(forceReload = false) {
      const loading = document.getElementById('loading-reclamaciones');
      const errorEl = document.getElementById('error-reclamaciones');
      const errorMsg = document.getElementById('error-reclamaciones-msg');
      const emptyEl = document.getElementById('empty-reclamaciones');
      const tableContainer = document.getElementById('table-reclamaciones-container');

      if (window.reclamacionesLoaded && !forceReload) return;

      loading?.classList.remove('hidden');
      errorEl?.classList.add('hidden');
      emptyEl?.classList.add('hidden');
      tableContainer?.classList.add('hidden');

      try {
        const res = await fetch('/api/admin/reclamaciones');
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Error HTTP ${res.status}`);
        }
        const data = await res.json();
        currentReclamaciones = Array.isArray(data) ? data : [];
        window.reclamacionesLoaded = true;
        loading?.classList.add('hidden');

        if (currentReclamaciones.length === 0) {
          emptyEl?.classList.remove('hidden');
          return;
        }

        renderReclamacionesTable(currentReclamaciones);
        tableContainer?.classList.remove('hidden');
      } catch (err) {
        console.error('Error loading reclamaciones:', err);
        loading?.classList.add('hidden');
        errorEl?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = err.message || 'Error al conectar con el servidor';
      }
    }

    function escapeHtml(text) {
      if (text === null || text === undefined) return '';
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderReclamacionesTable(list) {
      const tbody = document.getElementById('reclamaciones-table-body');
      if (!tbody) return;

      const now = new Date().getTime();

      tbody.innerHTML = list.map((item, idx) => {
        const fechaReg = item.fecha_registro || item.created_at;
        const fechaRegStr = fechaReg ? new Date(fechaReg).toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '—';
        
        let rowClass = 'hover:bg-secondary/40 transition';
        let deadlineBadge = '—';

        if (item.fecha_limite) {
          const limite = new Date(item.fecha_limite).getTime();
          const limiteDateStr = new Date(item.fecha_limite).toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' });
          const diffMs = limite - now;
          const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

          if (diffMs <= 0) {
            rowClass = 'bg-red-50/80 hover:bg-red-100/80 transition text-red-950 font-medium border-l-4 border-red-600';
            deadlineBadge = `<span class="inline-flex items-center gap-1 bg-red-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full whitespace-nowrap">⚠️ Vencido (${limiteDateStr})</span>`;
          } else if (diffDays <= 3) {
            rowClass = 'bg-amber-50/80 hover:bg-amber-100/80 transition text-amber-950 border-l-4 border-amber-500';
            deadlineBadge = `<span class="inline-flex items-center gap-1 bg-amber-500 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full whitespace-nowrap">⏳ Vence en ${diffDays === 1 ? '1 día' : diffDays + ' días'} (${limiteDateStr})</span>`;
          } else {
            deadlineBadge = `<span class="inline-flex items-center gap-1 bg-primary/10 text-primary text-[11px] font-semibold px-2.5 py-0.5 rounded-full whitespace-nowrap">${limiteDateStr} (${diffDays} d)</span>`;
          }
        }

        const tipoBadge = item.tipo_reclamacion === 'queja'
          ? '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-xs font-semibold uppercase">Queja</span>'
          : '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-xs font-semibold uppercase">Reclamo</span>';

        const consumidorName = item.tipo_persona === 'juridica' && item.razon_social
          ? `${escapeHtml(item.nombre_completo)} <span class="block text-[11px] opacity-70">(${escapeHtml(item.razon_social)})</span>`
          : escapeHtml(item.nombre_completo || '—');

        const docStr = `${escapeHtml(item.tipo_documento || 'DOC')}: ${escapeHtml(item.numero_documento || '—')}`;

        return `
          <tr class="${rowClass}">
            <td class="p-3 font-mono font-bold text-xs text-primary whitespace-nowrap">${escapeHtml(item.codigo || '—')}</td>
            <td class="p-3 text-xs opacity-75 whitespace-nowrap">${fechaRegStr}</td>
            <td class="p-3 text-sm">${consumidorName}${item.es_menor ? '<span class="ml-1 text-[10px] text-amber-700 bg-amber-100 px-1 rounded">Menor</span>' : ''}</td>
            <td class="p-3 text-xs opacity-90 font-mono">${docStr}</td>
            <td class="p-3">${tipoBadge}</td>
            <td class="p-3">${deadlineBadge}</td>
            <td class="p-3 text-right whitespace-nowrap">
              <button type="button" onclick="showReclamacionDetail(${idx})" class="text-xs bg-primary text-white px-2.5 py-1 rounded hover:opacity-90 font-semibold shadow-xs">
                Ver detalle
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function showReclamacionDetail(idx) {
      const item = currentReclamaciones[idx];
      if (!item) return;

      const modal = document.getElementById('modal-reclamacion');
      const content = document.getElementById('modal-reclamacion-content');

      const fechaRegStr = item.fecha_registro || item.created_at ? new Date(item.fecha_registro || item.created_at).toLocaleString('es-PE') : '—';
      const fechaLimStr = item.fecha_limite ? new Date(item.fecha_limite).toLocaleDateString('es-PE') : '—';

      content.innerHTML = `
        <div class="border-b border-primary/10 pb-4">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider bg-primary/10 text-primary px-2.5 py-1 rounded">
              Hoja de Reclamación
            </span>
            <span class="font-mono text-sm font-bold text-primary">${escapeHtml(item.codigo)}</span>
          </div>
          <h3 class="font-heading text-xl font-bold mt-2">Detalle de la ${item.tipo_reclamacion === 'queja' ? 'Queja' : 'Reclamación'}</h3>
          <p class="text-xs text-stone-500">Registrado el ${fechaRegStr} · Plazo legal de respuesta: ${fechaLimStr}</p>
        </div>

        <div class="space-y-4 text-xs">
          <!-- Consumidor -->
          <div class="bg-secondary/40 p-3 rounded-xl border border-primary/10">
            <h4 class="font-bold text-primary mb-2 text-xs uppercase tracking-wider">1. Datos del Consumidor</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
              <p><strong class="text-stone-600">Nombre / Razón Social:</strong> ${escapeHtml(item.nombre_completo)} ${item.razon_social ? `(${escapeHtml(item.razon_social)})` : ''}</p>
              <p><strong class="text-stone-600">Documento:</strong> ${escapeHtml(item.tipo_documento || 'DOC')}: ${escapeHtml(item.numero_documento || '—')}</p>
              <p><strong class="text-stone-600">Email:</strong> <a href="mailto:${escapeHtml(item.email || '')}" class="underline text-blue-700">${escapeHtml(item.email || '—')}</a></p>
              <p><strong class="text-stone-600">Teléfono:</strong> <a href="https://wa.me/${(item.telefono || '').replace(/\D/g, '')}" target="_blank" class="underline text-emerald-700 font-bold">${escapeHtml(item.telefono || '—')}</a></p>
              <p class="md:col-span-2"><strong class="text-stone-600">Dirección:</strong> ${escapeHtml(item.direccion || '—')}, ${escapeHtml(item.ciudad || '—')}</p>
              ${item.es_menor ? `
                <div class="md:col-span-2 mt-2 pt-2 border-t border-primary/10 text-amber-900">
                  <p><strong>⚠️ Menor de edad. Apoderado:</strong> ${escapeHtml(item.apoderado_nombre || '—')} (${escapeHtml(item.apoderado_documento || '—')})</p>
                </div>
              ` : ''}
            </div>
          </div>

          <!-- Bien contratado -->
          <div class="bg-secondary/40 p-3 rounded-xl border border-primary/10">
            <h4 class="font-bold text-primary mb-2 text-xs uppercase tracking-wider">2. Bien Contratado</h4>
            <p><strong class="text-stone-600">Tipo:</strong> <span class="capitalize font-semibold">${escapeHtml(item.tipo_bien || '—')}</span></p>
            ${item.monto_reclamado != null ? `<p><strong class="text-stone-600">Monto Reclamado:</strong> S/ ${Number(item.monto_reclamado).toFixed(2)}</p>` : ''}
            <p class="mt-1"><strong class="text-stone-600">Descripción:</strong> ${escapeHtml(item.descripcion_bien || '—')}</p>
          </div>

          <!-- Detalle de la Reclamación -->
          <div class="bg-secondary/40 p-3 rounded-xl border border-primary/10">
            <h4 class="font-bold text-primary mb-2 text-xs uppercase tracking-wider">3. Detalle y Pedido</h4>
            <div class="space-y-2">
              <div>
                <strong class="text-stone-700 block mb-1">Detalle expresado por el consumidor:</strong>
                <p class="p-2.5 bg-white rounded border border-primary/10 whitespace-pre-wrap text-stone-800">${escapeHtml(item.detalle || '—')}</p>
              </div>
              <div>
                <strong class="text-stone-700 block mb-1">Pedido concreto:</strong>
                <p class="p-2.5 bg-white rounded border border-primary/10 whitespace-pre-wrap text-stone-800">${escapeHtml(item.pedido || '—')}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-3 border-t border-primary/10 flex justify-end">
          <button type="button" onclick="closeReclamacionModal()" class="px-5 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 text-xs font-bold rounded-lg transition">
            Cerrar
          </button>
        </div>
      `;

      modal?.classList.remove('hidden');
    }

    function closeReclamacionModal() {
      document.getElementById('modal-reclamacion')?.classList.add('hidden');
    }
  </script>
</body>
</html>
