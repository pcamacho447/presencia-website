        </div>

        <div id="loading-catalogo" class="text-center py-8 opacity-70">Cargando catálogo desde Supabase...</div>
        
        <form id="catalogo-form" class="hidden space-y-8">
          <div id="catalogo-container" class="space-y-6"></div>
          
          <div class="flex items-center justify-between pt-6 border-t border-primary/10">
            <div id="msg-catalogo" class="text-sm font-semibold"></div>
            <button type="submit" id="save-catalogo-btn" class="bg-primary text-white py-3 px-8 rounded-xl font-bold hover:opacity-90 transition shadow-sm">
              Guardar Cambios del Catálogo
            </button>
          </div>
