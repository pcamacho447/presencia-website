    async function executeShopifySync() {
      const domainInput = document.getElementById('shopify_domain_input');
      const tokenInput = document.getElementById('shopify_token_input');
      const msg = document.getElementById('shopify-sync-msg');
      const btn = document.getElementById('btn-exec-sync');

      const domain = domainInput.value.trim();
      const token = tokenInput.value.trim();

      if (!domain || !token) {
        msg.className = 'text-xs font-semibold text-red-600';
        msg.textContent = 'Ingresa el dominio y el token de Storefront.';
        return;
      }

      btn.disabled = true;
      msg.className = 'text-xs font-semibold text-emerald-800 animate-pulse';
      msg.textContent = 'Conectando con Shopify Storefront API...';

      try {
        const res = await fetch('/api/admin/shopify-sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain, token, autoSave: true })
        });
        const result = await res.json();
        if (res.ok && result.ok) {
          msg.className = 'text-xs font-semibold text-emerald-700';
          msg.textContent = `¡Sincronizado! Se importaron ${result.count} productos de Shopify.`;
          currentCatalogo = result.products;
          renderCatalogoForm(currentCatalogo);
          setTimeout(() => {
            document.getElementById('shopify-sync-drawer')?.classList.add('hidden');
          }, 3000);
        } else {
          msg.className = 'text-xs font-semibold text-red-600';
          msg.textContent = result.error || result.warning || 'Error al sincronizar con Shopify.';
        }
      } catch (err) {
        msg.className = 'text-xs font-semibold text-red-600';
        msg.textContent = 'Error de conexión con el servidor.';
      } finally {
        btn.disabled = false;
      }
    }

