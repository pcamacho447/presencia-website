        <button onclick="closeReclamacionModal()" type="button" class="absolute top-5 right-5 text-stone-400 hover:text-stone-700 text-xl font-bold">
          ✕
        </button>
        <div id="modal-reclamacion-content">
          <!-- Dinámicamente poblado -->
        </div>
      </div>
    </div>

    <!-- Pestaña 2: Paquetes y Precios -->
    <section id="tab-content-paquetes" class="tab-content hidden">
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-primary/10">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
          <div>
            <h2 class="font-heading text-2xl font-bold">Edición de Paquetes y Precios</h2>
            <p class="text-xs opacity-70">Gestiona nombres, precios, beneficios y botones de compra para los paquetes del landing.</p>
          </div>
          <button type="button" onclick="addNewPaquete()" class="bg-primary/10 text-primary border border-primary/20 px-4 py-2 rounded-xl text-xs font-bold hover:bg-primary/20 transition">
            + Añadir Paquete
          </button>
        </div>
        <div id="loading-paquetes" class="text-center py-8 opacity-70">Cargando paquetes desde Supabase...</div>
        
        <form id="paquetes-form" class="hidden space-y-8">
          <div id="paquetes-container" class="space-y-6"></div>
          
          <div class="flex items-center justify-between pt-6 border-t border-primary/10">
            <div id="msg-paquetes" class="text-sm font-semibold"></div>
            <button type="submit" id="save-paquetes-btn" class="bg-primary text-white py-3 px-8 rounded-xl font-bold hover:opacity-90 transition shadow-sm">
              Guardar Cambios de Paquetes
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Pestaña: Catálogo Floral -->
    <section id="tab-content-catalogo" class="tab-content hidden">
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-primary/10">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
          <div>
            <h2 class="font-heading text-2xl font-bold">Catálogo de Arreglos Florales</h2>
            <p class="text-xs opacity-70">Gestiona precios, fotos, disponibilidad y botones de Shopify / WhatsApp.</p>
          </div>
          <button type="button" onclick="addNewArreglo()" class="bg-emerald-700 text-white px-4 py-2 rounded-xl text-xs font-bold hover:bg-emerald-800 transition shadow-sm">
            + Añadir Arreglo Floral
          </button>
        </div>

        <!-- Banner de Sincronización Automática con Shopify -->
        <div class="mb-6 p-4 rounded-xl border border-emerald-200 bg-emerald-50/70 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2">
              <span class="text-xl">🛍️</span>
              <h3 class="text-sm font-bold text-emerald-950">Sincronización Automática con Shopify (Storefront API)</h3>
            </div>
            <p class="text-xs text-emerald-800 mt-1">
              Conecta tu tienda de Shopify para importar automáticamente productos, fotos, precios y enlaces directos de checkout.
            </p>
          </div>
          <button 
            type="button" 
            onclick="document.getElementById('shopify-sync-drawer').classList.toggle('hidden')" 
            class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold transition shadow-sm whitespace-nowrap"
