      </div>
    </section>

    <!-- Pestaña 3: Hero y Contenidos -->
    <section id="tab-content-sitio" class="tab-content hidden">
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-primary/10">
